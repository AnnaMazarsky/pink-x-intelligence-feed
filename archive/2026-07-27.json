  "headlines": [
    {
      "title": "SyndicateRoom UK filings: no all-female-founded raise above 50M pounds in 3+ years",
      "summary": "SyndicateRoom analysis of UK filings shows the all-female-founded share of deals moved 6.6% to 6.2% and share of capital moved 3.4% to 3.5% between 2023 and Q1 2026, with average all-female round of 1.2M pounds versus all-male 2.4M pounds. Zero all-female-founded companies broke the 50M pound raise barrier in three years.",
      "source": "UKBAA / SyndicateRoom",
      "url": "https://ukbaa.org.uk/blog/2026/07/22/the-50m-ceiling-three-years-of-uk-filings-show-no-all-female-founded-raise-has-broken-through/",
      "date": "2026-07-22",
      "priority": "P1"
    },
    {
      "title": "Israel launches NIS 1B (~$330M) shekel fast-track for tech companies",
      "summary": "Israel Innovation Authority + Ministry of Finance opened applications on Jul 26 for Israeli tech cos with 50%+ shekel expenses hit by the strong shekel. Up to NIS 15M per company (~$4.6M, covering 33 to 50% of an 18-month runway), with decisions in 4 weeks. Applications close Aug 31.",
      "source": "Globes",
      "url": "https://en.globes.co.il/en/article-aid-launched-for-tech-cos-hit-by-strong-shekel-1001550435",
      "date": "2026-07-26",
      "priority": "P3"
    },
